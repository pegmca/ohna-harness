# Web 对宿主机暴露的端口；可选，默认 8080。
AIAGENT_WEB_PORT=8080
AIAGENT_POSTGRES_PORT=5432

# PostgreSQL 运行在 Docker 中；宿主机 pnpm dev 使用 127.0.0.1。
POSTGRES_DB=aiagent
POSTGRES_USER=aiagent
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://aiagent:replace-with-local-password@127.0.0.1:5432/aiagent
# PDF bytes 的专用本地存储根目录；不得设置为仓库根目录或用户可控路径。
ARTIFACT_STORAGE_ROOT=./var/artifacts

# 浏览器指纹只在服务端以 HMAC 摘要保存。生产环境必须使用随机长字符串。
IDENTITY_FINGERPRINT_PEPPER=replace-with-random-pepper
IDENTITY_SESSION_TTL_DAYS=30
# 本地 HTTP 为 false；生产 HTTPS 必须为 true。
IDENTITY_COOKIE_SECURE=false

# 统一 QQ Bot。二维码是 QQ 开放平台提供的固定 Bot 二维码 URL。
QQBOT_ENABLED=false
QQBOT_APP_ID=
QQBOT_APP_SECRET=
QQBOT_PUBLIC_QR_URL=

# 启动模式；必填语义，默认 mock。mock 无需 API key，real 会启用 OpenAI-compatible client。
AIAGENT_PROVIDER_MODE=mock

# real 模式配置。provider 可选，默认 openai-compatible；API key 与 model 在 real 模式必填。
AIAGENT_LLM_PROVIDER=openai-compatible
AIAGENT_LLM_API_KEY=replace-with-provider-key
AIAGENT_LLM_BASE_URL=https://api.openai.com/v1
AIAGENT_LLM_MODEL=replace-with-model-name
AIAGENT_LLM_TIMEOUT_MS=30000

# API 容器内部监听配置；Compose 已提供默认值，通常无需修改。
HOST=0.0.0.0
PORT=3001

# 兼容旧配置（可选）：OPENAI_API_KEY、OPENAI_BASE_URL、OPENAI_MODEL、MODEL_PROVIDER、
# MODEL_API_KEY、MODEL_BASE_URL、MODEL_NAME。profile 还可使用 AIAGENT_LLM_*_<PROFILE>；
# kimi-code profile 兼容 MODEL_API_KEY_KIMI、MODEL_BASE_URL_KIMI、MODEL_NAME_KIMI。
# OPENAI_API_KEY=replace-with-provider-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=replace-with-model-name
# MODEL_PROVIDER=openai-compatible
# MODEL_API_KEY=replace-with-provider-key
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=replace-with-model-name
# AIAGENT_LLM_API_KEY_KIMI=replace-with-kimi-key
# AIAGENT_LLM_BASE_URL_KIMI=https://api.kimi.com/coding/v1
# AIAGENT_LLM_MODEL_KIMI=kimi-for-coding
# MODEL_API_KEY_KIMI=replace-with-kimi-key
# MODEL_BASE_URL_KIMI=https://api.kimi.com/coding/v1
# MODEL_NAME_KIMI=kimi-for-coding
