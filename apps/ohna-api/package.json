{
  "name": "@aiagent/ohna-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ohna-api": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "pnpm --filter @aiagent/serve build && pnpm --filter @aiagent/ai build && pnpm --filter @aiagent/coding build && tsc -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@aiagent/ai": "workspace:*",
    "@aiagent/coding": "workspace:*",
    "@aiagent/serve": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
