{
  "name": "@aiagent/ohna-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ohna": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "build": "tsc -b",
    "test": "pnpm build && node --test test/*.test.mjs",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "pnpm --filter @aiagent/ai build && pnpm --filter @aiagent/agent build && pnpm --filter @aiagent/tools build && pnpm --filter @aiagent/coding build && tsc -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@aiagent/agent": "workspace:*",
    "@aiagent/ai": "workspace:*",
    "@aiagent/coding": "workspace:*",
    "@aiagent/eval-core": "workspace:*",
    "@aiagent/mcp": "workspace:*",
    "@aiagent/serve": "workspace:*",
    "@aiagent/term": "workspace:*",
    "@aiagent/tools": "workspace:*",
    "@aiagent/types": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
