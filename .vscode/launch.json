{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug AI stream verify OpenRouter",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/test/verify-ai-stream.mjs",
      "args": [
        "--case",
        "chat",
        "--provider",
        "openrouter"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug LLM Tool Trace OpenRouter",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/test/debug-llm-tool-trace.mjs",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Build Workspace",
      "env": {
        "AIAGENT_LLM_PROVIDER": "openrouter"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug Agent Loop",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/test/verify-agent-loop.mjs",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
