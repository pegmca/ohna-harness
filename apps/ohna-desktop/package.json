{
  "name": "@aiagent/ohna-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "description": "ohna Electron desktop client",
  "author": "ohna contributors",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.utility.config.ts",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "pnpm build && node --test test/*.test.mjs",
    "package": "pnpm build && electron-builder",
    "package:dir": "pnpm build && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.5"
  }
}
