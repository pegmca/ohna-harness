{
  "name": "@aiagent/finance-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -b",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "pnpm --filter @aiagent/agent build && pnpm --filter @aiagent/report build && pnpm --filter @aiagent/identity build && pnpm --filter @aiagent/database build && pnpm --filter @aiagent/channels build && pnpm --filter @aiagent/mcp build && tsc -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@aiagent/agent": "workspace:*",
    "@aiagent/ai": "workspace:*",
    "@aiagent/channels": "workspace:^",
    "@aiagent/conversation": "workspace:^",
    "@aiagent/database": "workspace:^",
    "@aiagent/identity": "workspace:^",
    "@aiagent/mcp": "workspace:^",
    "@aiagent/rag": "workspace:*",
    "@aiagent/report": "workspace:*",
    "@aiagent/tools": "workspace:*",
    "@aiagent/trace": "workspace:*",
    "@aiagent/types": "workspace:*",
    "fastify": "^5.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "pg": "8.16.3"
  }
}
