{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "types": ["vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/core/types.ts",
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "src/web/**/*.d.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
