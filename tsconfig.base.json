{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@aiagent/agent": ["./packages/agent/src/index.ts"],
      "@aiagent/channels": ["./packages/channels/src/index.ts"],
      "@aiagent/coding": ["./packages/coding/src/index.ts"],
      "@aiagent/conversation": ["./packages/conversation/src/index.ts"],
      "@aiagent/database": ["./packages/database/src/index.ts"],
      "@aiagent/eval": ["./packages/eval/src/index.ts"],
      "@aiagent/parsing": ["./packages/parsing/src/index.ts"],
      "@aiagent/mcp": ["./packages/mcp/src/index.ts"],
      "@aiagent/rag": ["./packages/rag/src/index.ts"],
      "@aiagent/ohna-runtime": ["./packages/ohna-runtime/src/index.ts"],
      "@aiagent/report": ["./packages/report/src/index.ts"],
      "@aiagent/security": ["./packages/security/src/index.ts"],
      "@aiagent/identity": ["./packages/identity/src/index.ts"],
      "@aiagent/types": ["./packages/types/src/index.ts"],
      "@aiagent/tools": ["./packages/tools/src/index.ts"],
      "@aiagent/trace": ["./packages/trace/src/index.ts"],
      "@aiagent/workflow": ["./packages/workflow/src/index.ts"]
    }
  }
}
