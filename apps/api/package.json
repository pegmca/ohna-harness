{
  "name": "@aiagent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "pnpm --filter @aiagent/agent build && tsc -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@aiagent/agent": "workspace:*",
    "@aiagent/rag": "workspace:*",
    "@aiagent/types": "workspace:*",
    "fastify": "^5.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
