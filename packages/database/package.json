{
  "name": "@aiagent/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm build && node dist/migrate.js",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "pnpm --filter @aiagent/conversation build && pnpm --filter @aiagent/identity build && pnpm --filter @aiagent/rag build && pnpm --filter @aiagent/report build && tsc -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@aiagent/conversation": "workspace:*",
    "@aiagent/identity": "workspace:*",
    "@aiagent/rag": "workspace:*",
    "@aiagent/report": "workspace:*",
    "drizzle-orm": "0.44.7",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.5"
  }
}
