{
  "name": "aiagent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently -n finance-api,finance-web -c blue,green \"pnpm --filter @aiagent/finance-api dev\" \"pnpm --filter @aiagent/finance-web dev\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:shell": "docker compose exec postgres psql -U aiagent -d aiagent",
    "db:migrate": "pnpm --filter @aiagent/database build && node --env-file-if-exists=.env packages/database/dist/migrate.js",
    "db:status": "docker compose ps postgres",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "lint": "eslint apps packages --max-warnings 250",
    "architecture:check": "depcruise apps packages --config .dependency-cruiser.cjs",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter @aiagent/finance-web test:e2e",
    "eval:ohna": "pnpm --filter @aiagent/ohna-eval eval",
    "smoke:compose": "node test/smoke-compose.mjs",
    "eval:finance-api": "pnpm --filter @aiagent/finance-api eval",
    "eval:finance-api:update-baseline": "pnpm --filter @aiagent/finance-api eval --update-baseline",
    "eval:finance-golden": "pnpm --filter @aiagent/finance-api eval:golden",
    "eval:finance-golden:update-baseline": "pnpm --filter @aiagent/finance-api eval:golden:update-baseline",
    "eval:finance-golden:generate": "pnpm --filter @aiagent/finance-golden-studio generate",
    "eval:finance-golden:validate": "pnpm --filter @aiagent/finance-golden-studio validate",
    "eval:finance-golden:annotate": "pnpm --filter @aiagent/finance-golden-studio annotate",
    "eval:finance-golden:mine": "pnpm --filter @aiagent/finance-golden-studio mine",
    "eval:finance-golden:promote": "pnpm --filter @aiagent/finance-golden-studio promote",
    "golden-studio": "node --import tsx apps/finance-golden-studio/src/cli/main.ts",
    "eval:ohna:update-baseline": "pnpm --filter @aiagent/ohna-eval eval --update-baseline"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.5",
    "concurrently": "^10.0.3",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  }
}
