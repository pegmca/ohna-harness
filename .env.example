# Web 对宿主机暴露的端口；可选，默认 8080。
AIAGENT_WEB_PORT=8080
AIAGENT_POSTGRES_PORT=5432

# PostgreSQL 运行在 Docker 中；宿主机 pnpm dev 使用 127.0.0.1。
POSTGRES_DB=aiagent
POSTGRES_USER=aiagent
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://aiagent:replace-with-local-password@127.0.0.1:5432/aiagent
# PDF bytes 的专用本地存储根目录；不得设置为仓库根目录或用户可控路径。
ARTIFACT_STORAGE_ROOT=./var/artifacts

# 浏览器指纹只在服务端以 HMAC 摘要保存。生产环境必须使用随机长字符串。
IDENTITY_FINGERPRINT_PEPPER=replace-with-random-pepper
IDENTITY_SESSION_TTL_DAYS=30
# 本地 HTTP 为 false；生产 HTTPS 必须为 true。
IDENTITY_COOKIE_SECURE=false

# 统一 QQ Bot。二维码是 QQ 开放平台提供的固定 Bot 二维码 URL。
QQBOT_ENABLED=false
QQBOT_APP_ID=
QQBOT_APP_SECRET=
QQBOT_PUBLIC_QR_URL=

# 启动模式；必填语义，默认 mock。mock 无需 API key，real 会启用 OpenAI-compatible client。
AIAGENT_PROVIDER_MODE=mock
# 显式 mock 模式下，每个首次出现的运行类别延迟毫秒数；测试可设为 0。
AIAGENT_MOCK_STEP_DELAY_MS=500

# real 模式：每个具名 profile 必须同时配齐 API key 与 model 才会被启用；
# 至少配置一个即可（不再要求 deepseek + openrouter 同时齐全）。未配置的 profile 不进入模型目录。
# DeepSeek
AIAGENT_LLM_API_KEY_DEEPSEEK=
AIAGENT_LLM_BASE_URL_DEEPSEEK=https://api.deepseek.com/v1
AIAGENT_LLM_MODEL_DEEPSEEK=
# OpenRouter（可选）
AIAGENT_LLM_API_KEY_OPENROUTER=
AIAGENT_LLM_BASE_URL_OPENROUTER=https://openrouter.ai/api/v1
AIAGENT_LLM_MODEL_OPENROUTER=
# 自托管 LLM provider（统一 AIAGENT_LLM_*，无 suffix）：chat / context-enricher / query-rewriter 共用。
# 配置后 server 的模型目录会启用该端点（目录 profile id 仍为 bridge_ai，配置来源已切到本组变量，
# 旧的 AIAGENT_LLM_*_BRIDGE_AI 后缀变量仅作为兜底保留）。
AIAGENT_LLM_API_KEY=
AIAGENT_LLM_BASE_URL=http://your-llm-endpoint.example.com/v1
AIAGENT_LLM_MODEL=hy3-x
AIAGENT_LLM_TIMEOUT_MS=30000

# 独立的 RAG provider（v1.1 拆分，互不共享变量/模型；每组 base URL、API key、model 齐全才启用）：
# Embedding（/v1/embeddings）
AIAGENT_EMBEDDING_API_KEY=
AIAGENT_EMBEDDING_BASE_URL=http://your-llm-endpoint.example.com/v1
AIAGENT_EMBEDDING_MODEL=
# 向量维度需与 packages/database 的向量列迁移一致；不填默认 1536。
AIAGENT_EMBEDDING_DIMENSIONS=1536
# Rerank（/v1/rerank 或回退 LLM-judge）
AIAGENT_RERANK_API_KEY=
AIAGENT_RERANK_BASE_URL=
AIAGENT_RERANK_MODEL=
# Judge（eval 的 LLM-as-judge）
AIAGENT_JUDGE_API_KEY=
AIAGENT_JUDGE_BASE_URL=
AIAGENT_JUDGE_MODEL=

# 未绑定聊天附件的保留小时数；API 启动后及每小时执行一次有界清理。
AIAGENT_ATTACHMENT_ORPHAN_TTL_HOURS=24

# API 容器内部监听配置；Compose 已提供默认值，通常无需修改。
HOST=0.0.0.0
PORT=3001

# 单 client/脚本兼容旧配置（不用于 DeepSeek/OpenRouter 目录）：OPENAI_API_KEY、OPENAI_BASE_URL、OPENAI_MODEL、MODEL_PROVIDER、
# MODEL_API_KEY、MODEL_BASE_URL、MODEL_NAME。profile 还可使用 AIAGENT_LLM_*_<PROFILE>；
# kimi-code profile 兼容 MODEL_API_KEY_KIMI、MODEL_BASE_URL_KIMI、MODEL_NAME_KIMI。
# OPENAI_API_KEY=replace-with-provider-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=replace-with-model-name
# MODEL_PROVIDER=openai-compatible
# MODEL_API_KEY=replace-with-provider-key
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=replace-with-model-name
# AIAGENT_LLM_API_KEY_KIMI=replace-with-kimi-key
# AIAGENT_LLM_BASE_URL_KIMI=https://api.kimi.com/coding/v1
# AIAGENT_LLM_MODEL_KIMI=kimi-for-coding
# MODEL_API_KEY_KIMI=replace-with-kimi-key
# MODEL_BASE_URL_KIMI=https://api.kimi.com/coding/v1
# MODEL_NAME_KIMI=kimi-for-coding
